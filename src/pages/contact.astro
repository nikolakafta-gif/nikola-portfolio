---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

/*
 * ==== FILL THIS IN ====
 * Your Cal.com link, without the domain. It is whatever follows cal.com/ in
 * your booking URL — username plus the event slug.
 * Example: "nikola-miljkovic/30min"
 *
 * The name field, the "what do you need" question and the Teams/Zoom choice
 * are all configured in Cal.com itself, not here. The embed only renders what
 * your event type already defines.
 */
const CAL_LINK = "nikolamiljkovic/30min";
/* ====================== */

const contactBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.nikolamiljkovic.live/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact",
      "item": "https://www.nikolamiljkovic.live/contact/"
    }
  ]
};

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Nikola Miljković",
  "description": "Book a free 30-minute call with Nikola Miljkovic to talk through your web project. Full website builds, redesigns, migrations and SEO, delivered in 1-3 weeks.",
  "mainEntity": {
    "@type": "Person",
    "name": "Nikola Miljković",
    "jobTitle": "Web Developer",
    "email": "n.miljkovic1987@outlook.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Nis",
      "addressCountry": "RS"
    },
    "sameAs": [
      "https://www.linkedin.com/in/nikola-miljkovic-542456108/"
    ]
  }
};
---

<BaseLayout title="Book a Call | Nikola Miljković" description="Book a free 30-minute call with Nikola Miljkovic to talk through your web project. Full website builds, redesigns, migrations and SEO, delivered in 1-3 weeks." schema={contactSchema} extraSchemas={[contactBreadcrumb]}>
  <Navbar />
  <main id="main-content">
    <section class="contact-body">
      {/* Kept for search engines and screen readers: the page is otherwise a
          single embedded iframe with no heading of its own. */}
      <h1 class="sr-only">Book a call with Nikola Miljković</h1>

      <div class="contact-body__inner container">
        <!-- Cal.com renders into this. Height is reserved up front so the
             calendar arriving does not shove the footer down (CLS). -->
        <div class="cal-embed" id="cal-embed" data-cal-link={CAL_LINK}>
          <p class="cal-embed__fallback">Loading the calendar…</p>
        </div>

        <p class="contact-body__alt">
          Prefer not to book a call? Email me at
          <a href="mailto:n.miljkovic1987@outlook.com">n.miljkovic1987@outlook.com</a>
          or message me on WhatsApp, Viber or Telegram.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  /*
   * Cal.com ships a third-party script. Loading it on page load would cost
   * ~100KB of JavaScript before the visitor has scrolled anywhere near the
   * calendar, so it is deferred until the container is close to the viewport.
   * IntersectionObserver rather than a scroll threshold, so it fires reliably
   * even when the page is short enough that the embed starts in view.
   */
  const host = document.getElementById("cal-embed");

  if (host) {
    const calLink = host.dataset.calLink;
    let loaded = false;

    const load = () => {
      if (loaded || !calLink) return;
      loaded = true;

      // Official Cal.com embed bootstrap
      (function (C: any, A: string, L: string) {
        const p = (a: any, ar: any) => { a.q.push(ar); };
        const d = C.document;
        C.Cal = C.Cal || function () {
          const cal = C.Cal;
          const ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api: any = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else {
              p(cal, ar);
            }
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      const Cal = (window as any).Cal;

      Cal("init", { origin: "https://cal.com" });
      Cal("inline", {
        elementOrSelector: "#cal-embed",
        calLink,
        layout: "month_view",
        /*
         * Also set here, not just in Cal("ui"). The ui call reaches the iframe
         * over postMessage after it has already loaded, which lets a dark frame
         * flash first; passing it in the config puts it in the iframe URL.
         */
        config: { theme: "light" },
      });
      Cal("ui", {
        hideEventTypeDetails: false,
        layout: "month_view",
        /*
         * Pinned to light. Cal.com otherwise follows the visitor's system
         * preference, so anyone browsing in dark mode would get a black
         * calendar sitting inside a white page.
         */
        theme: "light",
        styles: {
          /* Matches --color-accent so the calendar does not look bolted on */
          branding: { brandColor: "#4928fd" },
        },
      });

      host.classList.add("is-loaded");
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          load();
          io.disconnect();
        }
      },
      { rootMargin: "400px" }
    );

    io.observe(host);
  }
</script>

<style>
  .contact-body {
    /* The hero used to clear the fixed 6em navbar. With it gone, that job
       moves here, otherwise the calendar slides under the nav. */
    padding-top: 9em;
    padding-bottom: var(--section-gap);
  }

  .contact-body__inner {
    max-width: 1272px;
  }

  .cal-embed {
    /* Reserved before the embed arrives, so nothing below it jumps */
    min-height: 40em;
    width: 100%;
    overflow: hidden;
    border-radius: 1em;
    border: 1px solid var(--color-primary-10);
    background-color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cal-embed.is-loaded {
    display: block;
    align-items: initial;
    justify-content: initial;
  }

  .cal-embed__fallback {
    font-family: var(--font-body);
    color: var(--color-primary-60);
    margin: 0;
  }

  .cal-embed.is-loaded .cal-embed__fallback {
    display: none;
  }

  .contact-body__alt {
    font-family: var(--font-body);
    color: var(--color-primary-60);
    text-align: center;
    font-size: 1em;
    line-height: 1.6;
    margin: 2em auto 0;
    max-width: 550px;
  }

  .contact-body__alt a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Tablet */
  @media (max-width: 991px) {
    .contact-body {
      padding-top: 8.5em;
    }
  }

  /* Mobile landscape */
  @media (max-width: 767px) {
    .contact-body {
      padding-top: 8em;
    }

    .cal-embed {
      min-height: 44em;
      border-radius: 0.75em;
    }
  }
</style>
