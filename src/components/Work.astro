---
/*
 * Each project belongs to one group, and the group is what the filter tabs
 * show. `industry` is the finer label printed on the card itself.
 */
const groups = [
  { id: "hospitality", label: "Hospitality & Tourism" },
  { id: "real-estate", label: "Real Estate & Architecture" },
  { id: "coaching", label: "Coaching & Consulting" },
  { id: "fitness", label: "Fitness & Health" },
];

const projects = [
  {
    title: "Porta Brzi Brod",
    imageSrc: "/assets/images/work-porta-brzi-brod.webp",
    href: "/blog/porta-brzi-brod/",
    group: "hospitality",
    industry: "Restaurant",
  },
  {
    title: "Casera",
    imageSrc: "/assets/images/work-casera.webp",
    href: "/blog/casera/",
    group: "hospitality",
    industry: "Hotel",
  },
  {
    title: "Zvonačka Banja",
    imageSrc: "/assets/images/work-zvonacka-banja.webp",
    href: "/blog/zvonacka-banja/",
    group: "hospitality",
    industry: "Tourism",
  },
  {
    title: "Klub Gama",
    imageSrc: "/assets/images/work-klub-gama.webp",
    href: "/blog/klub-gama/",
    group: "hospitality",
    industry: "Café",
  },
  {
    title: "Doorly",
    imageSrc: "/assets/images/work-doorly.webp",
    href: "/blog/doorly/",
    group: "real-estate",
    industry: "Real Estate",
  },
  {
    title: "Vistal",
    imageSrc: "/assets/images/work-vistal.webp",
    href: "/blog/vistal/",
    group: "real-estate",
    industry: "Architecture",
  },
  {
    title: "Victoria",
    imageSrc: "/assets/images/work-victoria.webp",
    href: "/blog/victoria/",
    group: "coaching",
    industry: "Business Coaching",
  },
  {
    title: "Advisia",
    imageSrc: "/assets/images/work-advisia.webp",
    href: "/blog/advisia/",
    group: "coaching",
    industry: "Consulting",
  },
  {
    title: "Comira",
    imageSrc: "/assets/images/work-comira.webp",
    href: "/blog/comira/",
    group: "fitness",
    industry: "Fitness App",
  },
];

const countFor = (id: string) => projects.filter((p) => p.group === id).length;

/* No "All" tab: the first group is selected when the page loads. */
const defaultGroup = groups[0].id;
---

<section class="work" id="work">
  <div class="work__inner container">
    <div class="work__content">
      <div class="work__header">
        <h2 class="work__heading" data-fade-up>How I transformed a small business into an <span class="work__italic">online presence</span></h2>
      </div>

      <div class="work__filters" role="group" aria-label="Filter projects by industry" data-fade-up>
        {groups.map((g) => (
          <button type="button" class="work__filter" data-work-filter={g.id} aria-pressed={String(g.id === defaultGroup)}>
            {g.label} <span class="work__filter-count">{countFor(g.id)}</span>
          </button>
        ))}
      </div>
    </div>

    <ul class="work__grid" data-fade-up>
      {projects.map((project) => (
        <li class="work__item" data-work-group={project.group} hidden={project.group !== defaultGroup}>
          <a href={project.href} class="work__card">
            <span class="work__card-media">
              <img
                src={project.imageSrc}
                srcset={`${project.imageSrc.replace('.webp', '-400.webp')} 400w, ${project.imageSrc.replace('.webp', '-700.webp')} 700w, ${project.imageSrc} 1120w`}
                sizes="(max-width: 767px) 92vw, (max-width: 991px) 46vw, 400px"
                alt={`${project.title} website preview`}
                class="work__card-img"
                width="600"
                height="400"
                loading="lazy"
              />
            </span>
            <span class="work__card-bottom">
              <span class="work__card-info">
                <span class="work__card-tag">{project.industry}</span>
                <span class="work__card-title">{project.title}</span>
              </span>
              <span class="work__card-view">
                View
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  function initWorkFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-work-filter]");
    const items = document.querySelectorAll<HTMLElement>("[data-work-group]");
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.workFilter;
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        items.forEach((item) => {
          item.hidden = item.dataset.workGroup !== filter;
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWorkFilters);
  } else {
    initWorkFilters();
  }
</script>

<style>
  .work {
    padding-top: var(--section-gap);
    padding-bottom: 0;
  }

  .work__inner {
    max-width: 1272px;
  }

  .work__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5em;
  }

  .work__header {
    display: flex;
    justify-content: center;
  }

  .work__heading {
    max-width: 768px;
    font-family: var(--font-body);
    color: var(--color-primary);
    text-align: center;
    font-size: 3em;
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
  }

  .work__italic {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -1px;
  }

  /* Filter tabs */
  .work__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5em;
  }

  .work__filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.625em 1.125em;
    border: 1px solid var(--color-primary-10, rgba(27, 29, 30, 0.1));
    border-radius: 999px;
    background: transparent;
    color: var(--color-primary);
    font: inherit;
    font-size: 0.875em;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .work__filter:hover {
    border-color: var(--color-primary-40, rgba(27, 29, 30, 0.4));
  }

  .work__filter[aria-pressed="true"] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white, #fff);
  }

  .work__filter-count {
    opacity: 0.5;
    font-variant-numeric: tabular-nums;
  }

  /* Grid */
  .work__grid {
    list-style: none;
    margin: 3em 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2em 1.5em;
  }

  .work__item[hidden] {
    display: none;
  }

  .work__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .work__card-media {
    display: block;
    border-radius: 1em;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-primary-10, rgba(27, 29, 30, 0.1));
  }

  .work__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .work__card:hover .work__card-img {
    transform: scale(1.03);
  }

  .work__card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    padding: 1em 0.25em 0;
  }

  .work__card-info {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
  }

  .work__card-tag {
    font-size: 0.75em;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-primary-40);
  }

  .work__card-title {
    font-size: 1.125em;
    font-weight: 600;
    color: var(--color-primary);
  }

  .work__card-view {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.875em;
    font-weight: 500;
    color: var(--color-primary);
    padding: 0.5em 1.25em;
    border-radius: 999px;
    border: 1px solid var(--color-primary-10, rgba(27, 29, 30, 0.1));
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .work__card:hover .work__card-view {
    background: var(--color-primary);
    color: var(--color-white, #fff);
  }

  @media (max-width: 991px) {
    .work__content {
      gap: 2em;
    }

    .work__heading {
      max-width: 500px;
      font-size: 2.25em;
    }

    .work__grid {
      margin-top: 2em;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work__card:hover .work__card-img {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    /* One row of tabs you swipe sideways, instead of a tall stack of pills */
    .work__filters {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      width: 100%;
      scrollbar-width: none;
    }

    .work__filters::-webkit-scrollbar {
      display: none;
    }

    .work__filter {
      flex: none;
    }

    .work__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75em;
    }
  }
</style>
